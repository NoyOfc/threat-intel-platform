# Copy to .env and fill in locally. NEVER commit .env or put real keys in this file.
# These values are read by the BACKEND only. Never prefix a secret with VITE_.

# Use canned provider data; no outbound network calls.
DEMO_MODE=true

ENVIRONMENT=development

# SQLite by default. Later, for PostgreSQL:
# DATABASE_URL=postgresql+psycopg://threatscope:<password>@db:5432/threatscope
DATABASE_URL=sqlite:///./data/threatscope.db

# Threat intelligence providers (optional; leave blank in demo mode)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# Per-provider request timeout in seconds (max 30)
PROVIDER_TIMEOUT_SECONDS=8

# Threat feed collection from fixed public sources, only when "Refresh Intelligence" is clicked.
# Independent of DEMO_MODE. Set to false to disable all feed network access.
FEEDS_ENABLED=true
